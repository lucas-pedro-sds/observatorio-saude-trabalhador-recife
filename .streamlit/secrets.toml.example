# Opcional. O app publicado não precisa de Secrets: sem credenciais, ele usa a cópia em
# dashboard/snapshot/. Use isto só se quiser o app na nuvem lendo o banco ao vivo; nesse caso,
# cole este conteúdo, preenchido, em "App settings > Secrets", com o usuário de leitura.
# Localmente não é preciso: o app lê o .env da raiz.
DASHBOARD_FONTE = "banco"

[db]
host = ""
port = ""
name = "defaultdb"
user = "time_analise"
password = ""
