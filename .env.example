# Copie este arquivo para .env (nunca commitar o .env de verdade) e preencha com
# suas próprias credenciais.

# Google Cloud — usado pelo pipeline/01_coleta.py para consultar RAIS/CAGED/CID-10 via basedosdados
GCP_BILLING_PROJECT_ID=seu-projeto-gcp

# PostgreSQL (Aiven) — usado pelo pipeline/03_carga.py. Peça os valores reais no grupo do time.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
